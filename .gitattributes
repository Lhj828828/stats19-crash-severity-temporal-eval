# Keep reproducibility inputs byte-stable across operating systems.
* text=auto

*.py text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.cff text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.gz binary
*.npz binary
*.npy binary
*.joblib binary
*.zip binary
*.7z binary

# These post-review snapshots are already SHA-256 sealed; preserve their bytes.
config/final_analysis/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
config/random_reference_revision/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
config/stats19_feature_revision/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
logs/final_analysis/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
logs/random_reference_revision/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
logs/stats19_feature_revision/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
results/final_analysis/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
results/random_reference_revision/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
results/stats19_feature_revision/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
# Retain the exact documentation-test source copied by the accepted clean run.
tests/test_public_documentation.py -text whitespace=trailing-space,space-before-tab,cr-at-eol
