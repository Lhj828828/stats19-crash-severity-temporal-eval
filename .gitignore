# Local manuscript drafts and journal-specific templates
manuscript/

# Raw data snapshots are reproducible from the documented official sources.
# Keep directory placeholders, but do not commit the data files themselves.
data/raw/downloads/*
!data/raw/downloads/.gitkeep
data/raw/collisions/*
!data/raw/collisions/.gitkeep
data/raw/cas/*
!data/raw/cas/.gitkeep

# Rebuildable intermediate tables and fitted model binaries
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep

# Large record-level result artifacts. Compact summary CSV files remain tracked.
results/**/predictions/*
results/**/validation_predictions/*
results/**/shap_values/*
results/**/*.npz
results/**/*.npy
results/**/*.joblib
results/**/*.csv.gz

# Rebuildable CAS post-hoc sensitivity outputs
models/cas_feature_ablation/*
results/cas_feature_ablation/*
logs/cas/cas_feature_ablation_*
config/cas/cas_feature_ablation_complete.json

# Common local archives and OS metadata
*.zip
*.tar
*.tar.gz
*.7z
.DS_Store
Thumbs.db
